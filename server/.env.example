# ---- Required ----
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/settlewise?retryWrites=true&w=majority
# Any long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Where the frontend runs. Comma-separate several origins, e.g.
#   http://localhost:5173,https://settlewise.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ---- Document reading (AI, optional) ----
# The built-in pattern reader always runs and needs no key. AI fills whatever it misses.
# openrouter (recommended: one key, many models), gemini, anthropic, or none.
LLM_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Optional ----
# On macOS, port 5000 is taken by AirPlay Receiver; use 5001 and set VITE_API_URL to match.
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Running "npm run seed" creates (or promotes) this admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
